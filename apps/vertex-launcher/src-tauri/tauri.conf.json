{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vertex",
  "mainBinaryName": "vertex-launcher",
  "version": "0.1.0",
  "identifier": "app.vertex.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vertex",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#120a22",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
